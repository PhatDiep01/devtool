# ==============================================================================
# DevToolkit Environment Configuration Template
# Copy this file to .env or devtoolkit/backend/.env and adjust configuration
# ==============================================================================

# Server Port (Default: 3001)
PORT=3001

# Master API Authentication Token
AUTH_TOKEN=devtoolkit-secret-change-me

# ------------------------------------------------------------------------------
# Persistent Data Directory (STRICTLY LOCAL - NEVER COMMITTED TO GIT)
# ------------------------------------------------------------------------------
# Can be a relative path (e.g. ./data_docs_tooldev) or an absolute Windows path
# Examples:
# DATA_DIR=./data_docs_tooldev
# DATA_DIR=D:/Source/docs_tooldev/data_docs_tooldev
# DATA_DIR=C:/Users/YourUser/DevToolkitData
DATA_DIR=./data_docs_tooldev

# ------------------------------------------------------------------------------
# Jira Integration (Optional)
# ------------------------------------------------------------------------------
JIRA_BASE_URL=https://your-jira-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_AUTH_TYPE=bearer
