# ==============================================================================
# Git Ignore Configuration for DevToolkit Sub-Package
# ==============================================================================

# Dependencies
node_modules/
dist/

# Logs
*.log
*.log.*
logs/
service-stdout.log
service-stderr.log
backend/service-stdout.log
backend/service-stderr.log

# Environment
.env
.env.*
.env.local
!.env.example

# Databases
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# Backend uploads
backend/data/images/*
!backend/data/images/.gitkeep

# Frontend & Caches
frontend/.firebase/
.firebase/
.cache/

# OS & Editors
.DS_Store
Thumbs.db
*.swp
*.swo
*.sw?
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
